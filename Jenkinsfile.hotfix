final String branchMain      = 'main'
final String repoOwner       = 'apim-gitflow'
final String repoName        = 'wso2-apim-app'
final String repoUrl         = "https://github.com/${repoOwner}/${repoName}.git"
final String versionPattern  = /\d+\.\d+\.\d+/

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        GITHUB_APP = 'github-credentials'
    }

    parameters {
        string(
            name: 'BASE_TAG',
            defaultValue: '',
            description: 'Tag to branch from, e.g. 1.2.3 (as produced by the production pipeline).'
        )
        string(
            name: 'HOTFIX_VERSION_OVERRIDE',
            defaultValue: '',
            description: 'Explicit hotfix version MAJOR.MINOR.PATCH. Default: patch+1 of BASE_TAG.'
        )
    }

    stages {
        stage('Resolve inputs') {
            steps {
                script {
                    String tag = params.BASE_TAG?.trim()
                    if (!(tag ==~ versionPattern)) {
                        error("BASE_TAG must be MAJOR.MINOR.PATCH. Got: '${tag}'")
                    }
                    env.BASE_TAG = tag

                    if (params.HOTFIX_VERSION_OVERRIDE?.trim()) {
                        String o = params.HOTFIX_VERSION_OVERRIDE.trim()
                        if (!(o ==~ versionPattern)) {
                            error("HOTFIX_VERSION_OVERRIDE must be MAJOR.MINOR.PATCH. Got: '${o}'")
                        }
                        env.HOTFIX_VERSION = o
                    } else {
                        List<String> parts = tag.tokenize('.')
                        env.HOTFIX_VERSION = "${parts[0]}.${parts[1]}.${parts[2].toInteger() + 1}"
                    }
                    env.HOTFIX_BRANCH = "hotfix/${env.HOTFIX_VERSION}"

                    currentBuild.displayName = "Start ${env.HOTFIX_BRANCH}"
                    echo "BASE_TAG=${env.BASE_TAG} | HOTFIX_BRANCH=${env.HOTFIX_BRANCH}"
                }
            }
        }

        stage('Guards: tag exists, hotfix branch free') {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        String tagExists = sh(
                            script: "git ls-remote --tags ${repoUrl} refs/tags/${env.BASE_TAG}",
                            returnStdout: true
                        ).trim()
                        if (!tagExists) {
                            error("Tag ${env.BASE_TAG} does not exist on origin. Aborting.")
                        }

                        String branchExists = sh(
                            script: "git ls-remote --heads ${repoUrl} refs/heads/${env.HOTFIX_BRANCH}",
                            returnStdout: true
                        ).trim()
                        if (branchExists) {
                            error("${env.HOTFIX_BRANCH} already exists on origin. Aborting.")
                        }
                    }
                }
            }
        }

        stage('Create hotfix branch') {
            steps {
                cleanWs()
                checkout scmGit(
                    userRemoteConfigs: [[
                        url: repoUrl,
                        credentialsId: env.GITHUB_APP
                    ]],
                    branches: [[name: branchMain]]
                )
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    // Fetch ONLY the one tag (don't import all tags), then branch from it.
                    sh """
                        set -e
                        git config user.email 'jenkins-ci@wso2-project'
                        git config user.name  'Jenkins CI'
                        git fetch --no-tags origin "refs/tags/${env.BASE_TAG}"
                        git checkout -B ${env.HOTFIX_BRANCH} FETCH_HEAD
                    """
                }
                script {
                    String raw = readFile('VERSION').trim()
                    def m = raw =~ /^(\d+\.\d+\.\d+)\+(\d+\.\d+\.\d+)$/
                    if (!m) {
                        error("VERSION at tag ${env.BASE_TAG} must be WSO2+CUSTOM. Got: '${raw}'.")
                    }
                    env.WSO2_VERSION = m[0][1]
                }
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        echo "${env.WSO2_VERSION}+${env.HOTFIX_VERSION}" > VERSION

                        if git diff --quiet -- VERSION; then
                            echo "VERSION bump not needed (override matched tag content)."
                        else
                            git add VERSION
                            git commit -m "Start hotfix ${env.WSO2_VERSION}+${env.HOTFIX_VERSION} [skip ci]"
                        fi
                        git push origin ${env.HOTFIX_BRANCH}
                    """
                }
            }
        }
    }

    post {
        success {
            script {
                echo "Created ${env.HOTFIX_BRANCH} from tag ${env.BASE_TAG}."
                echo "Developers commit fixes on ${env.HOTFIX_BRANCH}."
                echo "When ready, run Jenkinsfile.production with RELEASE_BRANCH=${env.HOTFIX_BRANCH} (the production pipeline will also delete the hotfix branch on success)."
            }
        }
        always {
            cleanWs()
        }
    }
}
