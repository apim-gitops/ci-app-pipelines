final String branchMain       = 'main'
final String branchDevelop    = 'develop'
final String repoOwner        = 'WSO2-Project'
final String repoName         = 'wso2-apim-app'
final String repoUrl          = "https://github.com/${repoOwner}/${repoName}.git"
final String versionPattern   = /\d+\.\d+\.\d+/
final String releaseBranchRx  = /release\/\d+\.\d+\.\d+/
final String fullVersionRx    = /^(\d+\.\d+\.\d+)\+(\d+\.\d+\.\d+)(-SNAPSHOT)?$/

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        GITHUB_APP = 'github-credentials'
    }

    parameters {
        booleanParam(
            name: 'AUTO_BUMP_MINOR',
            defaultValue: true,
            description: 'Automatically bump the MINOR of the custom version for the next develop iteration.'
        )
        string(
            name: 'NEXT_DEV_VERSION_OVERRIDE',
            defaultValue: '',
            description: 'Explicit next custom version MAJOR.MINOR.PATCH. Used only when AUTO_BUMP_MINOR is unchecked.'
        )
    }

    parameters {
        booleanParam(
            name: 'AUTO_BUMP_MINOR',
            defaultValue: true,
            description: 'Bump develop to the next MINOR (x.Y+1.0). Uncheck to set the next dev version manually.'
        )
        string(
            name: 'NEXT_DEV_VERSION_OVERRIDE',
            defaultValue: '',
            description: 'Explicit next dev version MAJOR.MINOR.PATCH. Used only when AUTO_BUMP_MINOR is unchecked.'
        )
    }

    stages {
        stage('Checkout develop') {
            steps {
                cleanWs()
                checkout scmGit(
                    userRemoteConfigs: [[
                        url: repoUrl,
                        credentialsId: env.GITHUB_APP
                    ]],
                    branches: [[name: branchDevelop]],
                    extensions: [localBranch(branchDevelop)]
                )
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        git fetch --no-tags origin ${branchMain} ${branchDevelop}
                        git checkout -B ${branchDevelop} origin/${branchDevelop}
                        git reset --hard origin/${branchDevelop}
                    """
                }
            }
        }

        stage('Compute versions') {
            steps {
                script {
                    String raw = readFile('VERSION').trim()

                    // ── Parse: WSO2_VERSION+CUSTOM_VERSION[-SNAPSHOT] ──
                    def vm = raw =~ fullVersionRx
                    if (!vm) {
                        error("VERSION must be <WSO2_VERSION>+<CUSTOM_VERSION>[-SNAPSHOT]. Got: '${raw}'")
                    }
                    env.WSO2_VERSION      = vm[0][1]                     // e.g. 4.7.0
                    env.CUSTOM_VERSION    = vm[0][2]                     // e.g. 0.1.0
                    env.IS_SNAPSHOT       = vm[0][3] ? true : false      // present on develop, absent on release branch

                    if (!env.IS_SNAPSHOT.toBoolean()) {
                        error("VERSION on develop must end with -SNAPSHOT. Got: '${raw}'. Are you on the right branch?")
                    }

                    // ── The version we're releasing (strip -SNAPSHOT) ──
                    env.RELEASE_VERSION = env.CUSTOM_VERSION
                    env.RELEASE_BRANCH  = "release/${env.RELEASE_VERSION}"

                    // ── Compute next develop version ──
                    if (params.AUTO_BUMP_MINOR) {
                        List<String> parts = env.RELEASE_VERSION.tokenize('.')
                        env.NEXT_DEV_VERSION = "${parts[0]}.${parts[1].toInteger() + 1}.0"
                    } else {
                        String override = params.NEXT_DEV_VERSION_OVERRIDE?.trim()
                        if (!override || !(override ==~ versionPattern)) {
                            error("NEXT_DEV_VERSION_OVERRIDE must be MAJOR.MINOR.PATCH. Got: '${override}'")
                        }
                        env.NEXT_DEV_VERSION = override
                    }

                    currentBuild.displayName = "Cut ${env.RELEASE_BRANCH}"
                    echo """
                    ┌─────────────────────────────────────────────────────┐
                    │ WSO2 Version      : ${env.WSO2_VERSION}
                    │ Current Custom    : ${env.CUSTOM_VERSION}-SNAPSHOT
                    │ Release Version   : ${env.RELEASE_VERSION}
                    │ Release Branch    : ${env.RELEASE_BRANCH}
                    │ Next Dev Version  : ${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}-SNAPSHOT
                    └─────────────────────────────────────────────────────┘
                    """
                }
            }
        }

        stage('Guard: release branch must not exist') {
            steps {
                script {
                    // ── Same approach as Jenkinsfile.production: raw git ls-remote ──
                    String existing = ''
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        existing = sh(
                            script: "git ls-remote --heads ${repoUrl} refs/heads/${env.RELEASE_BRANCH}",
                            returnStdout: true
                        ).trim()
                    }
                    if (existing) {
                        error("${env.RELEASE_BRANCH} already exists on ${repoUrl}. Aborting.")
                    }
                    echo "Release branch ${env.RELEASE_BRANCH} is free."
                }
            }
        }

        stage('Create release branch') {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        sh """
                            set -e
                            git config user.email 'jenkins-ci@wso2-project'
                            git config user.name  'Jenkins CI'

                            git checkout -B ${env.RELEASE_BRANCH}

                            # Strip -SNAPSHOT: VERSION goes from 4.7.0+0.1.0-SNAPSHOT → 4.7.0+0.1.0
                            echo '${env.WSO2_VERSION}+${env.RELEASE_VERSION}' > VERSION

                            git add VERSION
                            git commit -m "Start release ${env.WSO2_VERSION}+${env.RELEASE_VERSION} [skip ci]"

                            git push origin ${env.RELEASE_BRANCH}
                        """
                    }
                }
            }
        }

        stage('Bump develop') {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        sh """
                            set -e
                            git config user.email 'jenkins-ci@wso2-project'
                            git config user.name  'Jenkins CI'

                            git checkout ${branchDevelop}
                            git pull --no-tags origin ${branchDevelop}

                            # develop gets: 4.7.0+0.2.0-SNAPSHOT
                            echo '${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}-SNAPSHOT' > VERSION

                            if git diff --quiet -- VERSION; then
                                echo "VERSION already at ${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}-SNAPSHOT; nothing to commit."
                            else
                                git add VERSION
                                git commit -m "Bump ${branchDevelop} to ${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}-SNAPSHOT [skip ci]"
                                git push origin ${branchDevelop}
                            fi
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                echo "✅ Created ${env.RELEASE_BRANCH}."
                echo "   VERSION on release branch : ${env.WSO2_VERSION}+${env.RELEASE_VERSION}"
                echo "   ${branchDevelop} is now    : ${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}-SNAPSHOT"
                echo ""
                echo "   Next step: run the production pipeline with RELEASE_BRANCH=${env.RELEASE_BRANCH}"
            }
        }
        failure {
            echo '❌ Release cut failed. Inspect the log above.'
        }
        always {
            cleanWs()
        }
    }
}
