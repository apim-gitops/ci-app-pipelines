final String branchDevelop = 'develop'
final String repoOwner     = 'WSO2-Project'
final String repoName      = 'wso2-apim-app'
final String versionPattern = /\d+\.\d+\.\d+/

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        GITHUB_APP = 'github-app-jenkins'
    }

    parameters {
        booleanParam(
            name: 'AUTO_BUMP_MINOR',
            defaultValue: true,
            description: 'Bump develop to the next MINOR (x.Y+1.0). Uncheck to set the next dev version manually.'
        )
        string(
            name: 'NEXT_DEV_VERSION_OVERRIDE',
            defaultValue: '',
            description: 'Explicit next dev version MAJOR.MINOR.PATCH. Used only when AUTO_BUMP_MINOR is unchecked.'
        )
    }

    stages {
        stage('Checkout develop') {
            steps {
                cleanWs()
                // GitHub App credential (GitHub Branch Source plugin) resolves to a
                // short-lived installation token; the Git plugin consumes it via credentialsId.
                // localBranch() gives us a real local 'develop' to cut/bump from.
                checkout scmGit(
                    userRemoteConfigs: [[
                        url: "https://github.com/${repoOwner}/${repoName}.git",
                        credentialsId: env.GITHUB_APP
                    ]],
                    branches: [[name: branchDevelop]],
                    extensions: [localBranch(branchDevelop)]
                )
                // No extra 'git fetch --tags' here: checkout scmGit already fetches tags,
                // and a raw git call outside a credential binding can't auth to the remote.
            }
        }

        stage('Compute versions') {
            steps {
                script {
                    String raw = readFile('VERSION').trim()
                    env.RELEASE_VERSION = raw.replace('-SNAPSHOT', '')

                    if (!(env.RELEASE_VERSION ==~ versionPattern)) {
                        error("VERSION must be MAJOR.MINOR.PATCH(-SNAPSHOT). Got: '${raw}'")
                    }

                    if (params.AUTO_BUMP_MINOR) {
                        List<String> parts = env.RELEASE_VERSION.tokenize('.')
                        env.NEXT_DEV_VERSION = "${parts[0]}.${parts[1].toInteger() + 1}.0"
                    } else {
                        String override = params.NEXT_DEV_VERSION_OVERRIDE
                        if (!(override ==~ versionPattern)) {
                            error("NEXT_DEV_VERSION_OVERRIDE must be MAJOR.MINOR.PATCH. Got: '${override}'")
                        }
                        env.NEXT_DEV_VERSION = override
                    }

                    env.RELEASE_BRANCH = "release/${env.RELEASE_VERSION}"

                    currentBuild.displayName = "Cut ${env.RELEASE_BRANCH}"
                    echo "RELEASE_VERSION=${env.RELEASE_VERSION} | " +
                        "RELEASE_BRANCH=${env.RELEASE_BRANCH} | " +
                        "NEXT_DEV_VERSION=${env.NEXT_DEV_VERSION}-SNAPSHOT"
                }
            }
        }

        stage('Guard: release branch must not exist') {
            steps {
                script {
                    String ref = "refs/heads/${env.RELEASE_BRANCH}"
                    String existing = withCredentials([
                        gitUsernamePassword(credentialsId: env.GITHUB_APP)
                    ]) {
                        sh(script: "git ls-remote --heads origin ${ref}", returnStdout: true).trim()
                    }
                    if (existing) {
                        error("${env.RELEASE_BRANCH} already exists on origin. Aborting.")
                    }
                }
            }
        }

        stage('Create release branch') {
            steps {
                // Cut release/<version> from develop and de-SNAPSHOT the VERSION file.
                // gitUsernamePassword binds the GitHub App token to the git CLI for push.
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        git config user.email 'jenkins-ci@wso2-project'
                        git config user.name 'Jenkins CI'
                        git checkout -B ${env.RELEASE_BRANCH}
                        echo '${env.RELEASE_VERSION}' > VERSION
                        git commit -am 'Start release ${env.RELEASE_VERSION} [skip ci]'
                        git push origin ${env.RELEASE_BRANCH}
                    """
                }
            }
        }

        stage('Bump develop') {
            steps {
                // Advance develop to the next -SNAPSHOT so it never collides with the release line.
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        git checkout ${branchDevelop}
                        git pull --ff-only origin ${branchDevelop}
                        echo '${env.NEXT_DEV_VERSION}-SNAPSHOT' > VERSION
                        git commit -am 'Bump develop to ${env.NEXT_DEV_VERSION}-SNAPSHOT [skip ci]'
                        git push origin ${branchDevelop}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Created ${env.RELEASE_BRANCH}; pushes to it auto-build RCs."
            echo "develop is now ${env.NEXT_DEV_VERSION}-SNAPSHOT."
        }
        failure {
            echo 'Release cut failed. No partial state should remain.'
        }
        always {
            cleanWs()
        }
    }
}
