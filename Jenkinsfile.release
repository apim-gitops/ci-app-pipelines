
final String branchDevelop = 'develop'
final String repoOwner    = 'WSO2-Project'
final String repoName     = 'wso2-apim-app'

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        GITHUB_APP = 'github-app-jenkins'
    }

    stages {
            stage('Checkout develop') {
            steps {
                cleanWs()
                gitHubAppCheckout(
                    credentialsId: env.GITHUB_APP,
                    repoOwner: repoOwner,
                    repository: repoName,
                    branch: branchDevelop
                )
                sh 'git fetch --tags'
            }
        }

        stage('Compute versions') {
            steps {
                script {
                    def raw = readFile('VERSION').trim()
                    env.RELEASE_VERSION = raw.replace('-SNAPSHOT', '')

                    if (!(env.RELEASE_VERSION ==~ /\d+\.\d+\.\d+/)) {
                        error "VERSION file must be MAJOR.MINOR.PATCH(-SNAPSHOT). Got: '${raw}'"
                    }

                    if (params.AUTO_BUMP_MINOR) {
                        def (major, minor, patch) = env.RELEASE_VERSION.tokenize('.')
                        env.NEXT_DEV_VERSION = "${major}.${(minor.toInteger() + 1)}.0"
                    } else {
                        if (!(params.NEXT_DEV_VERSION_OVERRIDE ==~ /\d+\.\d+\.\d+/)) {
                            error "NEXT_DEV_VERSION_OVERRIDE must be MAJOR.MINOR.PATCH. Got: '${params.NEXT_DEV_VERSION_OVERRIDE}'"
                        }
                        env.NEXT_DEV_VERSION = params.NEXT_DEV_VERSION_OVERRIDE
                    }

                    env.RELEASE_BRANCH = "release/${env.RELEASE_VERSION}"

                    currentBuild.displayName = "Cut ${env.RELEASE_BRANCH}"
                    echo """
                    ┌─────────────────────────────────────────┐
                    │ RELEASE_VERSION  : ${env.RELEASE_VERSION}
                    │ RELEASE_BRANCH   : ${env.RELEASE_BRANCH}
                    │ NEXT_DEV_VERSION : ${env.NEXT_DEV_VERSION}-SNAPSHOT
                    └─────────────────────────────────────────┘
                    """
                }
            }
        }

        stage('Guard: branch must not exist') {
            steps {
                script {
                    def gh = new GitHubHelper(
                        owner: repoOwner,
                        repo: repoName,
                        credentialsId: 'github-app'  // your GitHub App credential
                    )
                    def exists = gh.branchExists(env.RELEASE_BRANCH)
                    if (exists) {
                        error "${env.RELEASE_BRANCH} already exists on remote. Aborting."
                    }
                }
            }
        }

        stage('Create release branch') {
            steps {
                script {
                    sh """
                        git config user.email "jenkins-ci@wso2-project"
                        git config user.name  "Jenkins CI"
                        git checkout -B ${env.RELEASE_BRANCH}
                        echo "${env.RELEASE_VERSION}" > VERSION
                        git commit -am "Start release ${env.RELEASE_VERSION} [skip ci]"
                    """
                }
                // Push via GitHub API using the app
                githubAppCheckout([
                    credentialsId: 'github-app'
                ]) {
                    sh "git push origin ${env.RELEASE_BRANCH}"
                }
            }
        }

        stage('Bump develop') {
            steps {
                script {
                    sh """
                        git checkout ${branchDevelop}
                        git pull origin ${branchDevelop}
                        echo "${env.NEXT_DEV_VERSION}-SNAPSHOT" > VERSION
                        git commit -am "Bump develop to ${env.NEXT_DEV_VERSION}-SNAPSHOT [skip ci]"
                    """
                }
                // Push via GitHub API using the app
                githubAppCheckout([
                    credentialsId: 'github-app'
                ]) {
                    sh "git push origin ${branchDevelop}"
                }
            }
        }
    }

    post {
        success {
            echo "✅ Created ${env.RELEASE_BRANCH}. Pushes to it will auto-build RCs. develop is now ${env.NEXT_DEV_VERSION}-SNAPSHOT."
        }
        failure {
            echo '❌ Release cut failed. No partial state should remain.'
        }
        always {
            cleanWs()
        }
    }
}
