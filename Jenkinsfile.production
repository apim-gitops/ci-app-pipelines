final String branchMain       = 'main'
final String branchDevelop    = 'develop'
final String repoOwner        = 'WSO2-Project'
final String repoName         = 'wso2-apim-app'
final String repoUrl          = "https://github.com/${repoOwner}/${repoName}.git"
final String versionPattern   = /\d+\.\d+\.\d+/
final String releaseBranchRx  = /^(release|hotfix)\/\d+\.\d+\.\d+$/
final String WSO2_VERSION     = "4.7.0"

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'RELEASE_BRANCH',
            defaultValue: '',
            description: 'Release or hotfix branch to finalize (e.g., release/1.2.3 or hotfix/1.2.4)'
        )
    }

    environment {
        GITHUB_APP = 'wso2-apim-app-ci'
    }

    stages {
        // ═══════════════════════════════════════════════════════════════
        // GUARDS
        // ═══════════════════════════════════════════════════════════════
        stage('Guard: validate release branch format') {
            steps {
                script {
                    if (!params.RELEASE_BRANCH) {
                        error('RELEASE_BRANCH parameter is required')
                    }
                    if (!(params.RELEASE_BRANCH ==~ releaseBranchRx)) {
                        error("RELEASE_BRANCH must match pattern: release/X.Y.Z or hotfix/X.Y.Z, got: ${params.RELEASE_BRANCH}")
                    }
                    // Extra safety: never allow main or develop
                    if (params.RELEASE_BRANCH in [branchMain, branchDevelop]) {
                        error("Refusing to operate on protected branch: ${params.RELEASE_BRANCH}")
                    }
                    echo "✅ Branch format validated: ${params.RELEASE_BRANCH}"
                }
            }
        }

        stage('Guard: release branch must exist') {
            steps {
                script {
                    String existing = ''
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        existing = sh(
                            script: "git ls-remote --heads ${repoUrl} refs/heads/${params.RELEASE_BRANCH}",
                            returnStdout: true
                        ).trim()
                    }
                    if (!existing) {
                        error("Release branch does not exist on remote: ${params.RELEASE_BRANCH}")
                    }
                    echo '✅ Release branch exists on remote'
                }
            }
        }

        stage('Guard: release tag must NOT exist') {
            steps {
                script {
                    String tagName = params.RELEASE_BRANCH.replaceAll(/^(release|hotfix)\//, '')
                    String existing = ''
                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        existing = sh(
                            script: "git ls-remote --tags ${repoUrl} refs/tags/${tagName}",
                            returnStdout: true
                        ).trim()
                    }
                    if (existing) {
                        error("Tag already exists: ${tagName}. Was this release already finalized?")
                    }
                    echo "✅ Tag ${tagName} does not exist — safe to proceed"
                }
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // SETUP
        // ═══════════════════════════════════════════════════════════════
        stage('Checkout and configure git') {
            steps {
                script {
                    sh '''
                        set -e
                        git config --global user.email "jenkins-ci@wso2-project"
                        git config --global user.name "Jenkins CI"
                    '''
                }
            }
        }

        stage('Fetch all required branches') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        git init || true
                        git remote add origin ${repoUrl} 2>/dev/null || git remote set-url origin ${repoUrl}
                        git fetch --no-tags origin ${branchMain} ${branchDevelop} ${params.RELEASE_BRANCH}
                    """
                }
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // VERSION RESOLUTION
        // ═══════════════════════════════════════════════════════════════
        stage('Resolve versions from release branch') {
            steps {
                script {
                    String releaseVersion = sh(
                        script: "git show origin/${params.RELEASE_BRANCH}:VERSION",
                        returnStdout: true
                    ).trim()

                    def matcher = releaseVersion =~ /^(\d+\.\d+\.\d+)\+(\d+\.\d+\.\d+)$/
                    if (!matcher) {
                        error("VERSION file on release branch must be X.Y.Z+A.B.C (no -SNAPSHOT), got: ${releaseVersion}")
                    }

                    env.WSO2_VERSION = matcher[0][1]
                    env.RELEASE_VERSION = matcher[0][2]
                    env.TAG_NAME = "${env.RELEASE_VERSION}"

                    echo "Resolved: WSO2_VERSION=${env.WSO2_VERSION}, RELEASE_VERSION=${env.RELEASE_VERSION}, TAG=${env.TAG_NAME}"
                }
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // MERGE TO MAIN
        // ═══════════════════════════════════════════════════════════════
        stage('Merge release to main') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        git checkout -B ${branchMain} origin/${branchMain}
                        git merge --no-ff origin/${params.RELEASE_BRANCH} -m "Merge ${params.RELEASE_BRANCH} into ${branchMain} [ci skip]"
                    """
                }
            }
        }

        stage('Tag release on main') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        git tag -a ${env.TAG_NAME} -m "Release ${env.TAG_NAME} (WSO2 ${env.WSO2_VERSION})"
                        git push origin ${env.TAG_NAME}
                    """
                }
                echo "✅ Tagged: ${env.TAG_NAME}"
            }
        }

        stage('Push main') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh "git push origin ${branchMain}"
                }
                echo "✅ Pushed ${branchMain}"
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // MERGE TO DEVELOP
        // ═══════════════════════════════════════════════════════════════
        stage('Merge release to develop') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh """
                        set -e
                        git checkout -B ${branchDevelop} origin/${branchDevelop}
                        git merge --no-ff origin/${params.RELEASE_BRANCH} -m "Merge ${params.RELEASE_BRANCH} into ${branchDevelop} [ci skip]"
                    """
                }
            }
        }

        stage('Bump develop to next SNAPSHOT') {
            steps {
                script {
                    // Calculate next patch version: 1.2.3 -> 1.2.4
                    def parts = env.RELEASE_VERSION.tokenize('.')
                    def nextPatch = "${parts[0]}.${parts[1]}.${parts[2].toInteger() + 1}"
                    env.NEXT_DEV_VERSION = "${nextPatch}-SNAPSHOT"

                    String newVersion = "${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}"

                    sh """
                        set -e
                        echo "${newVersion}" > VERSION
                        git add VERSION
                        git diff --cached --quiet || git commit -m "Bump develop to ${newVersion} [ci skip]"
                    """
                }
            }
        }

        stage('Push develop') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                    sh "git push origin ${branchDevelop}"
                }
                echo "✅ Pushed ${branchDevelop} with next SNAPSHOT"
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // BRANCH DELETION
        // ═══════════════════════════════════════════════════════════════
        stage('Delete release branch') {
            when {
                expression { params.RELEASE_BRANCH ==~ releaseBranchRx }
            }
            steps {
                script {
                    // Final safety check: never delete protected branches
                    if (params.RELEASE_BRANCH in [branchMain, branchDevelop]) {
                        error("ABORTED: Refusing to delete protected branch ${params.RELEASE_BRANCH}")
                    }

                    echo "🔒 Deleting ${params.RELEASE_BRANCH}"
                    echo "   Build: ${env.BUILD_URL}"
                    echo "   Triggered by: ${env.BUILD_USER_ID ?: env.BUILD_USER ?: 'SCM/timer'}"

                    withCredentials([gitUsernamePassword(credentialsId: env.GITHUB_APP)]) {
                        sh """
                            set -e
                            git push origin --delete ${params.RELEASE_BRANCH}
                        """
                    }

                    echo "✅ Deleted ${params.RELEASE_BRANCH}"
                }
            }
        }
    }

    post {
        success {
            script {
                echo "✅ Release finalized: ${env.TAG_NAME}"
                echo "   WSO2 version: ${env.WSO2_VERSION}"
                echo "   Release: ${env.RELEASE_VERSION}"
                echo "   Develop now: ${env.WSO2_VERSION}+${env.NEXT_DEV_VERSION}"
                echo "   Branch ${params.RELEASE_BRANCH}: deleted"
            }
        }
        failure {
            echo '❌ Production pipeline failed. Check logs above.'
            echo '   Possible causes: merge conflict, branch protection, missing permission, network'
        }
        always {
            cleanWs()
        }
    }
}
